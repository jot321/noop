<?xml version="1.0" encoding="UTF-8"?>
<!--
  CloudSyncSecrets.example.plist — template for zero-touch cloud sync (CloudSyncProvisioning.swift).

  To use on your own build:
    1. Copy this file to `CloudSyncSecrets.plist` in the SAME folder (StrandiOS/Resources/).
    2. Fill in accessKeyId + secretAccessKey with a SCOPED IAM key (PutObject / GetObject /
       DeleteObject / ListBucket on just your bucket — nothing broader).
    3. Run `xcodegen generate` so the new resource is bundled, then build.

  `CloudSyncSecrets.plist` is gitignored (secrets.*) and must never be committed. This .example
  file carries no secret and is safe to commit as documentation.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>bucket</key>
    <string>my-noop-bucket</string>
    <key>region</key>
    <string>ap-south-1</string>
    <key>accessKeyId</key>
    <string>AKIA...</string>
    <key>secretAccessKey</key>
    <string>PASTE_YOUR_SCOPED_IAM_SECRET_HERE</string>
    <key>prefix</key>
    <string>noop</string>
    <key>retentionDays</key>
    <integer>60</integer>
    <key>enabled</key>
    <true/>
    <key>consent</key>
    <true/>
    <key>autoSync</key>
    <true/>
</dict>
</plist>
